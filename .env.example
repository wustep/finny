# Finny environment checklist. Full walkthrough: README.md.
# Two different places — nothing below is interchangeable between them.

# ============================================================
# 1. .env.local (Vite, this file's format) — gitignored
# ============================================================

# The deployment's .convex.cloud URL. `npx convex dev` writes this (and
# CONVEX_DEPLOYMENT) for you; on Vercel set it by hand in project settings.
VITE_CONVEX_URL=

# Optional. Must equal TEST_LOGIN_SECRET below; shows the local-only
# "Continue as tester" sign-in button. Never set this in Vercel.
VITE_TEST_LOGIN_SECRET=

# ============================================================
# 2. Convex deployment — set with `npx convex env set KEY value`
#    (these are NOT read from this file)
# ============================================================

# App origin in dev and the base for auth redirects: http://localhost:3466
# SITE_URL=

# Convex Auth token signing. Run `npx @convex-dev/auth` and it sets
# JWT_PRIVATE_KEY, JWKS, and SITE_URL for you.
# JWT_PRIVATE_KEY=
# JWKS=

# Google OAuth client (redirect URI uses .site, not .cloud):
# https://<deployment>.convex.site/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Plaid credentials. PLAID_SECRET must match PLAID_ENV (sandbox|production).
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=

# Notion public integration; redirect URI
# https://<deployment>.convex.site/notion/oauth/callback
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# Shared invite password gating every Plaid/Notion action. Required.
# Without it, signing in succeeds but redeeming returns "unconfigured"
# (a 503) and nothing in the app works. Three wrong guesses ban the IP.
# ACCESS_PASSWORD=

# Optional. Local sign-in without Google; must match VITE_TEST_LOGIN_SECRET.
# TEST_LOGIN_SECRET=

# Optional but strongly recommended once PLAID_ENV=production: lets
# connections started from localhost use the Plaid Sandbox. Without it,
# local link flows consume real production Items (10 lifetime on Trial).
# PLAID_SANDBOX_SECRET=

# Optional comma-separated extra app origins allowed as OAuth redirect
# targets, e.g. https://your-app.vercel.app
# APP_ORIGINS=
