# Frontend (Vite) — written to .env.local by `npx convex dev`
VITE_CONVEX_URL=

# ---- Convex deployment env vars (set with `npx convex env set KEY value`) ----
# Convex Auth (see README.md; `npx @convex-dev/auth` sets JWT keys for you)
#   SITE_URL=http://localhost:3466
#   AUTH_GOOGLE_ID=<google oauth client id>
#   AUTH_GOOGLE_SECRET=<google oauth client secret>
# Plaid (phase 2)
#   PLAID_CLIENT_ID=
#   PLAID_SECRET=
#   PLAID_ENV=sandbox
# Notion OAuth app (phase 3)
#   NOTION_CLIENT_ID=
#   NOTION_CLIENT_SECRET=
