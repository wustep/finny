    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.56.0",
    "next-themes": "^0.4.6",
    "plaid": "^45.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-plaid-link": "^5.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
