{
  "name": "finny",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n convex,vite -c magenta,cyan \"npm:convex:dev\" \"npm:dev:app\"",
    "dev:app": "vite",
    "convex:dev": "convex dev",
    "build": "tsc -b && vite build",
